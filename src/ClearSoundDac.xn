<?xml version="1.0" encoding="UTF-8"?>
<Network xmlns="http://www.xmos.com"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.xmos.com http://www.xmos.com">
  <Type>Board</Type>
  <Name>ClearSoundDac</Name>

  <Declarations>
    <Declaration>tileref tile[2]</Declaration>
  </Declarations>

  <Packages>
    <Package id="0" Type="XS3-UnA-1024-QF60A">
      <Nodes>
        <!-- Core clock: 600MHz, the part's rated speed (C24/I24 row; this board
             is a C32 die, rated f(MAX)=800MHz per the XU316 datasheet ordering
             table and the XK-EVK-XU316 board manual).

             DEFAULT IS 800MHz by owner directive (2026-11-05), which supersedes
             the 2026-11-04 directive that held this at 600MHz pending
             qualification. The 600MHz hold is kept as history because the
             diagnostic that justified the change is the measurement below: the
             clock, not the code, was the missing budget.
             Set SystemFrequency="600MHz" to reproduce the held state. Evidence:
               capture fill at 384 kHz, shipping shape MIXER=1 MAX_MIX_COUNT=2
                 preset 2   0.637 (600MHz) -> 0.851 (800MHz)
                 preset 0   0.764 (600MHz) -> 0.9995 (800MHz)
               MIXER=0, preset 0: 0.9995 at 600MHz -- the mixer relay inside
               audio()'s 781-tick half-frame deadline is the dominant term, so
               the software fix is to shorten that relay, not to raise the clock.
             Rejected as fixes (one boot each, runtime levers only): priority
             thread on the audio core 0.6374, on mixer1 0.6374, tap
             instrumentation removed 0.639, generator compiled out 0.6389.

             Package note: this file says XS3-UnA-1024-QF60A while the board
             manual says FB265, so do not treat it as an authoritative device
             description. Pin map IS correct for the bench board: HEAD carries
             main's map (BCLK=1A, LRCLK=1B, DAC_DATA=1C), identical to
             archive_revBB/ClearSoundDac_revBB.xn -- the mvp rotation
             (BCLK=1B, LRCLK=1C, DAC_DATA=1A, the one that silences the bench
             DAC at ~-87 dBFS) lived in merge commit 71c79b0 and is NOT in this
             file. (An earlier note here claimed the opposite; it had the two
             maps inverted. Verify against AGENTS.md before acting on either.) -->
        <Node Id="0" InPackageId="0" Type="XS3-L16A-1024" Oscillator="24MHz" SystemFrequency="600MHz" ReferenceFrequency="100MHz">
          <Boot>
            <Source Location="bootFlash"/>
          </Boot>
          <Tile Number="0" Reference="tile[0]">
            <Port Location="XS1_PORT_1B" Name="PORT_SQI_CS"/>
            <Port Location="XS1_PORT_1C" Name="PORT_SQI_SCLK"/>
            <Port Location="XS1_PORT_4B" Name="PORT_SQI_SIO"/>
            
			      <Port Location="XS1_PORT_8D" Name="PORT_CODEC_RST_N"/>	<!-- TBD -->

			      <Port Location="XS1_PORT_1A" Name="PORT_LED_D3G"/>		<!-- X0D00 = LED_7 = D3-green -->
		     <Port Location="XS1_PORT_1O"  Name="PORT_I2C_SCL"/>
            <Port Location="XS1_PORT_1P"  Name="PORT_I2C_SDA"/>
            
            <Port Location="XS1_PORT_1M"  Name="PORT_BUTTON_UP"/>
            <Port Location="XS1_PORT_1N"  Name="PORT_BUTTON_DOWN"/>
            
          </Tile>
          <Tile Number="1" Reference="tile[1]">
            <!-- Audio ports -->
            <Port Location="XS1_PORT_1D" Name="PORT_MCLK_IN"/>
            
            <Port Location="XS1_PORT_1A" Name="PORT_I2S_BCLK"/>
            <Port Location="XS1_PORT_1B" Name="PORT_I2S_LRCLK"/>
            <Port Location="XS1_PORT_1C" Name="PORT_I2S_DAC_DATA"/>
            <Port Location="XS1_PORT_1K" Name="PORT_I2S_ADC_DATA"/>
            <!-- Spare second ADC data input, pin 32 (X1D13/1F). Wired to the DAC
                 data line by the loopback rework; read as its own port, NOT as a
                 second I2S_WIRES_ADC wire (that would add audio channels and
                 change the USB descriptor). -->
            <Port Location="XS1_PORT_1F" Name="PORT_I2S_ADC_DATA_1"/>
            
            <Port Location="XS1_PORT_1A" Name="PORT_DSD_CLK"/>
            <Port Location="XS1_PORT_1B" Name="PORT_DSD_DAC0"/>
            <Port Location="XS1_PORT_1C" Name="PORT_DSD_DAC1"/>
          </Tile>
        </Node>
      </Nodes>
    </Package>
  </Packages>

  <Nodes>
    <Node Id="2" Type="device:" RoutingId="0x8000">
      <Service Id="0" Proto="xscope_host_data(chanend c);">
        <Chanend Identifier="c" end="3"/>
      </Service>
    </Node>
  </Nodes>

  <Links>
    <Link Encoding="2wire" Delays="5clk" Flags="XSCOPE">
      <LinkEndpoint NodeId="0" Link="XL0"/>
      <LinkEndpoint NodeId="2" Chanend="1"/>
    </Link>
  </Links>

  <ExternalDevices>
    <Device NodeId="0" Tile="0" Class="SQIFlash" Name="bootFlash" PageSize="256" SectorSize="4096" NumPages="8192">
      <Attribute Name="PORT_SQI_CS"   Value="PORT_SQI_CS"/>
      <Attribute Name="PORT_SQI_SCLK" Value="PORT_SQI_SCLK"/>
      <Attribute Name="PORT_SQI_SIO"  Value="PORT_SQI_SIO"/>
    </Device>
  </ExternalDevices>

  <JTAGChain>
    <JTAGDevice NodeId="0"/>
  </JTAGChain>

</Network>
