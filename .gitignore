.build_*/
build/
bin/
*.bak
# xcore flash/debug artifacts generated by xrun/xflash in-tree
/config.xml
/platform_def.xn
/program_info.txt
/xscope.xscope
/image_n0c*.elf

# python tooling caches and scratch output
__pycache__/
tools/dsp/_vfd_out/

# rig handoff state written by one phase and read by the next
# (trim_persist_check.py, trim_dfu_survive.py). Must NOT make the tree look
# dirty: the AGENTS.md release rule requires a clean repo state at build time,
# and an untracked file left behind by the last gate run would fail that check
# for a reason unrelated to the sources.
csd-js-tester/rig/.trim_expect
csd-js-tester/rig/.trim_dfu_expect

# generated by tools/gen_version.sh at cmake configure time -- committing it
# would make every build look dirty and churn the repo on every compile
/src/extensions/csd_version.h
/.build_count

# xflash byproducts written next to the .xn during flash runs
/src/extensions/image0*.bin
/src/extensions/loader.bin
